#!/sbin/sh
#
# /etc/init.d/sunslip - Solaris 8 service for SunSlip.
#

PATH=/usr/sbin:/usr/bin:/usr/local/sbin
export PATH

DEFAULTS=/etc/default/sunslip
PIDFILE=/var/run/sunslipattach.pid
LOGFILE=/var/adm/sunslip.log

TTY=/dev/term/b
LOCAL_ADDR=10.23.24.1
REMOTE_ADDR=10.23.24.2

if [ -r "$DEFAULTS" ]; then
    . "$DEFAULTS"
fi

start_sunslip()
{
    if [ -f "$PIDFILE" ]; then
        pid=`cat "$PIDFILE" 2>/dev/null`
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "SunSlip already running (pid $pid)."
            return 0
        fi
        rm -f "$PIDFILE"
    fi

    if [ ! -c /dev/sunslip0 ]; then
        echo "SunSlip device /dev/sunslip0 is missing."
        return 1
    fi

    echo "Starting SunSlip on $TTY..."
    /usr/local/sbin/sunslipattach "$TTY" >>"$LOGFILE" 2>&1 &
    pid=$!
    echo "$pid" > "$PIDFILE"

    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "sunslipattach failed; see $LOGFILE"
        rm -f "$PIDFILE"
        return 1
    fi

    ifconfig sunslip0 plumb
    if [ $? -ne 0 ]; then
        echo "Unable to plumb sunslip0."
        kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
        return 1
    fi

    ifconfig sunslip0 "$LOCAL_ADDR" "$REMOTE_ADDR" up
    if [ $? -ne 0 ]; then
        echo "Unable to configure sunslip0."
        ifconfig sunslip0 unplumb >/dev/null 2>&1
        kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
        return 1
    fi

    echo "SunSlip: $LOCAL_ADDR -> $REMOTE_ADDR on $TTY"
    return 0
}

stop_sunslip()
{
    echo "Stopping SunSlip..."
    ifconfig sunslip0 unplumb >/dev/null 2>&1

    if [ -f "$PIDFILE" ]; then
        pid=`cat "$PIDFILE" 2>/dev/null`
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$PIDFILE"
    else
        for pid in `ps -ef | grep '[s]unslipattach' | awk '{print $2}'`
        do
            kill "$pid" 2>/dev/null
        done
    fi
    return 0
}

case "$1" in
start)
    start_sunslip
    ;;
stop)
    stop_sunslip
    ;;
restart)
    stop_sunslip
    sleep 1
    start_sunslip
    ;;
status)
    if [ -f "$PIDFILE" ]; then
        pid=`cat "$PIDFILE" 2>/dev/null`
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "SunSlip running (pid $pid)."
            exit 0
        fi
    fi
    echo "SunSlip not running."
    exit 1
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit $?
